# ============================================================
# client/ — local dev configuration
# Copy this file to `client/.env` (gitignored, same as the backend's).
# Not needed for production builds -- server.js serves this SPA from the
# same origin as the API there, so relative paths just work.
# ============================================================

# The backend's URL, so this Vite dev server (a different origin/port) can
# reach it. Must match HTTP_PORT in the backend's own .env. The backend's
# CORS_ORIGIN must in turn be set to this dev server's own origin
# (http://localhost:5173 by default) or the browser will block the request.
VITE_API_BASE_URL=http://localhost:3000
