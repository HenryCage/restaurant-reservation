# ============================================================
# SMS Dispatch MVP — shared environment configuration
# Copy this file to `.env` and fill in the values.
# Per-tenant settings live in tenants.json, NOT here.
# NEVER commit the real .env (see .gitignore).
# ============================================================

# --- Runtime mode ---
# 'production' disables GLOBAL_TEST_NUMBER below. For a local demo, use 'development'.
NODE_ENV=production

# --- Google (shared service account; must have access to every tenant sheet) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com
# Keep the surrounding double quotes. The literal \n sequences MUST be un-escaped to
# real newlines at load time (e.g. key.replace(/\\n/g, '\n')) or Google auth fails.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- SMS provider ---
# Each tenant picks its own provider + credentials via the superadmin UI
# (tenant edit form -> SMS Provider) -- there is no global provider/API key
# here anymore. See docs/superpowers/specs/2026-07-16-per-tenant-sms-provider-design.md.
# A tenant with no provider configured simply doesn't send (loudly logged,
# not silently dropped) until a superadmin fills one in.
DEFAULT_COUNTRY_CODE=234

# --- Behaviour ---
# Tenant configuration lives in the `tenants` SQLite table (DB_PATH below),
# not a file -- see docs/superpowers/specs/2026-07-16-tenant-management-design.md.
# One-time move from an existing tenants.json: node scripts/migrate-tenants.mjs
POLL_INTERVAL_SECONDS=60
SEND_DELAY_MS=400              # delay between sends to avoid rate limits
HTTP_TIMEOUT_MS=15000          # per request (SMS + Sheets); a hang must not stall the tick

# --- Safety guardrails ---
# Bulk-edit cap: if a tenant has more eligible rows in one tick, send up to this many,
# log a LOUD warning (likely a bulk paste / fat-finger), and process the rest next tick.
MAX_SENDS_PER_TENANT_PER_TICK=50

# --- Contacts & campaigns (Foundation merge; see docs/superpowers/specs) ---
DB_PATH=data/platform.db       # SQLite file; created automatically on first run
CAMPAIGN_TICK_INTERVAL_MS=10000
MAX_CAMPAIGN_RECIPIENTS_PER_TICK=50

# --- Customer-facing auth + HTTP API (see docs/superpowers/specs) ---
HTTP_PORT=3000
SESSION_TTL_HOURS=168          # 7 days; a login cookie is valid this long from creation, not sliding
CORS_ORIGIN=                   # the dashboard's origin once it exists (e.g. http://localhost:5173); empty disables CORS
LOGIN_RATE_LIMIT_MAX=10        # failed login attempts allowed per email...
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15   # ...within this many minutes, before 429s kick in
# There is no self-service signup or email-based invite/reset (v1). Provision
# users with: node scripts/create-user.mjs --email=<email> --tenant=<tenant-id>
#         or: node scripts/create-user.mjs --email=<email> --superadmin
# Each prints a one-time temporary password to share with the user out-of-band.

# --- Demo / safety ---
DRY_RUN=false                  # true = log the SMS instead of calling the gateway (still marks the row)
# If set, ALL messages (all tenants) go to this number; HONORED ONLY when NODE_ENV != production.
# Logs a loud warning every tick while active. Overrides per-tenant testNumber.
GLOBAL_TEST_NUMBER=
